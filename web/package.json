{
  "private": true,
  "name": "grapevine-web",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3000 --strictPort",
    "dev:local": "VITE_LOCAL_SUPABASE=1 bun --bun vite dev --port 3001 --strictPort",
    "export": "bun --bun vite build",
    "fmt": "bun --bun biome format --write",
    "lint": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json && bun --bun tsc --noEmit -p tsconfig.sw.json && bun --bun biome check",
    "test": "bun test",
    "check:signin": "node scripts/signin-check.mjs",
    "check:feed": "node scripts/feed-check.mjs",
    "check:pwa": "node scripts/pwa-check.mjs",
    "seed:local": "bun scripts/seed-local.ts",
    "check:search-id": "bun scripts/search-id-check.ts",
    "check:recs-function": "node scripts/recs-function-check.mjs",
    "check:recs-parity": "node scripts/recs-parity-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "postgres": "^4.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
