{
  "private": true,
  "name": "grapevine-web",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3000 --strictPort",
    "dev:local": "VITE_LOCAL_SUPABASE=1 bun --bun vite dev --port 3001 --strictPort",
    "export": "bun --bun vite build",
    "fmt": "bun --bun biome format --write",
    "lint": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json && bun --bun tsc --noEmit -p tsconfig.sw.json && bun --bun biome check",
    "test": "bun test",
    "e2e": "playwright test",
    "e2e:pwa": "playwright test --project pwa",
    "e2e:stack": "playwright test --project stack",
    "e2e:signin": "playwright test signin",
    "e2e:feed": "playwright test feed",
    "e2e:search-id": "playwright test search-id",
    "e2e:map": "playwright test taste-map",
    "stack:local": "bash ../supabase/tests/serve-local.sh",
    "seed:local": "bun e2e/seed-local.ts",
    "open:local": "bun e2e/open-local.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "postgres": "^4.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
