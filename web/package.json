{
  "private": true,
  "name": "grapevine-web",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "dev:local": "NEXT_PUBLIC_LOCAL_SUPABASE=1 next dev --turbo --port 3001",
    "export": "next build",
    "fmt": "biome format --write",
    "lint": "tsc && tsc --noEmit -p tsconfig.sw.json && biome check",
    "test": "bun test",
    "check:signin": "node scripts/signin-check.mjs",
    "check:feed": "node scripts/feed-check.mjs",
    "check:pwa": "node scripts/pwa-check.mjs",
    "seed:local": "bun scripts/seed-local.ts",
    "check:search-id": "bun scripts/search-id-check.ts",
    "check:recs-function": "node scripts/recs-function-check.mjs",
    "check:suggestions": "node scripts/suggestions-check.mjs",
    "check:recs-parity": "node scripts/recs-parity-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "next": "^16.3.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "postcss": "^8.5.26",
    "postgres": "^3.4.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2"
  }
}
